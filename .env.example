# Application
APP_NAME=WhatsApp AI Agent
APP_VERSION=0.1.0
ENV=production
DEBUG=false
PORT=8001
SECRET_KEY=replace-me
ALLOWED_HOSTS=yourdomain.com
CORS_ORIGINS=https://yourfrontend.com
LOG_LEVEL=INFO
LOG_FORMAT=plain
LOG_TO_FILE=0

# WhatsApp API (Meta/Twilio etc.)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_VERIFY_TOKEN=
# Optional: App-level subscription
APP_ID=
APP_SECRET=
APP_ACCESS_TOKEN=

# AI
GEMINI_API_KEY=
AI_MODEL=gemini-pro

# Database (optional)
MONGO_URL=mongodb://mongo:27017
MONGO_DB_NAME=whatsapp_agent
DISABLE_DB=1
REDIS_URL=redis://redis:6379/0

# Metrics / Monitoring
ENABLE_METRICS=0
SENTRY_DSN=

# Ngrok (dev or optional production with reserved domain)
USE_NGROK=0
NGROK_AUTHTOKEN=
NGROK_REGION=us
NGROK_DOMAIN=
